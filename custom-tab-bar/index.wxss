.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 12rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar-inner {
  height: 118rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(213, 223, 218, 0.9);
  border-radius: 38rpx;
  box-shadow: 0 18rpx 50rpx rgba(14, 46, 38, 0.12);
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: relative;
  transition: opacity 0.15s;
}

.tab-item:active {
  opacity: 0.65;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
}

.tab-label {
  font-size: 19rpx;
  line-height: 1.2;
  color: #8a938f;
  letter-spacing: 1rpx;
}

.tab-item.active .tab-label {
  color: #1b5a47;
  font-weight: 600;
}

.tab-item.center {
  justify-content: flex-end;
  padding-bottom: 8rpx;
}

.center-btn {
  position: absolute;
  top: -44rpx;
  width: 98rpx;
  height: 98rpx;
  border-radius: 50%;
  background: #163f34;
  border: 6rpx solid #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(14, 46, 38, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s, background 0.18s;
}

.center-btn-active {
  background: #1b5a47;
  transform: scale(1.04);
}

.center-icon {
  width: 46rpx;
  height: 46rpx;
}

.tab-item.center .tab-label {
  color: #8a938f;
  font-weight: 500;
}

.tab-item.center.active .tab-label {
  color: #1b5a47;
  font-weight: 600;
}
