.radar-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radar-canvas {
  width: 100%;
  height: 100%;
}

.radar-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40rpx;
}

.radar-empty-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--green-50);
  color: var(--green-500);
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.radar-empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.radar-empty-desc {
  font-size: var(--fs-min);
  color: var(--muted-2);
  margin-top: 8rpx;
  line-height: 1.6;
  max-width: 380rpx;
}

.tap-hover { opacity: 0.74; }
