/* 空态是全局唯一的：颜色、字号、圆角全部引用 app.wxss 令牌 */
.empty-state {
  padding: 90rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-compact {
  padding: 56rpx 36rpx;
}

.empty-mark {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--green-50);
  color: var(--green-500);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  margin-bottom: 26rpx;
}

.empty-compact .empty-mark {
  width: 96rpx;
  height: 96rpx;
  font-size: 38rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty-desc {
  font-size: var(--fs-min);
  color: var(--muted);
  margin-top: 10rpx;
  line-height: 1.7;
  max-width: 460rpx;
}

.empty-action {
  margin-top: 30rpx;
  min-height: var(--tap-min);
  padding: 0 34rpx;
  border-radius: var(--radius-pill);
  background: var(--green-50);
  color: var(--green-700);
  font-size: 24rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tap-hover { opacity: 0.74; }
