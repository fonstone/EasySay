.empty-state {
  padding: 90rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-mark {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f6f2;
  color: #2f7b63;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  margin-bottom: 26rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #16211d;
}

.empty-desc {
  font-size: 24rpx;
  color: #74827c;
  margin-top: 10rpx;
  line-height: 1.7;
  max-width: 460rpx;
}

.empty-action {
  margin-top: 30rpx;
  height: 68rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #f0f6f2;
  color: #1b5a47;
  font-size: 24rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
}
