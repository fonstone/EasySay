<view class="empty-state {{compact ? 'empty-compact' : ''}}" aria-label="{{title}}">
  <view class="empty-mark serif" aria-hidden="true">{{mark}}</view>
  <view class="empty-title">{{title}}</view>
  <view wx:if="{{desc}}" class="empty-desc">{{desc}}</view>
  <view wx:if="{{action}}" class="empty-action" bindtap="onAction" hover-class="tap-hover" aria-label="{{action}}" aria-role="button">{{action}}</view>
</view>
