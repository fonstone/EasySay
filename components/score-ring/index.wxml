<view class="score-ring" style="width: {{size}}rpx; height: {{size}}rpx;">
  <canvas type="2d" id="ring" class="ring-canvas"></canvas>
  <view class="ring-content">
    <view class="ring-score serif">{{displayScore}}</view>
    <view wx:if="{{label}}" class="ring-label">{{label}}</view>
    <view wx:if="{{sublabel}}" class="ring-sub">{{sublabel}}</view>
  </view>
</view>
