.quiz {
  padding-top: 28rpx;
  padding-bottom: calc(50rpx + env(safe-area-inset-bottom));
}

.quiz-top {
  padding: 0 4rpx;
}

.quiz-type {
  display: inline-flex;
  font-size: var(--fs-min);
  border-radius: var(--radius-pill);
  padding: 6rpx 16rpx;
  letter-spacing: 1rpx;
}

.quiz-progress {
  font-size: var(--fs-min);
  color: var(--muted-2);
}

.quiz-stem {
  margin-top: 30rpx;
  font-size: 44rpx;
  line-height: 1.55;
  color: var(--ink);
}

.quiz-acc {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.option-list {
  margin-top: 38rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  padding: 24rpx 24rpx;
  transition: border-color 0.18s, background 0.18s, opacity 0.18s;
}

.option:active {
  border-color: var(--green-200);
}

.option-key {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--bg-deep);
  color: var(--muted);
  font-size: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: "Songti SC", serif;
}

.option-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--ink-2);
  padding-top: 4rpx;
}

.option.correct {
  border-color: var(--green-600);
  background: var(--green-50);
}

.option.correct .option-key {
  background: var(--green-600);
  color: #fff;
}

.option.wrong {
  border-color: var(--danger);
  background: var(--danger-soft);
}

.option.wrong .option-key {
  background: var(--danger);
  color: #fff;
}

.option.dim {
  opacity: 0.5;
}

.option-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-min);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.option.correct .option-icon {
  background: var(--green-600);
  color: #fff;
}

.option.wrong .option-icon {
  background: var(--danger);
  color: #fff;
}

.answer-card {
  margin-top: 30rpx;
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--line);
}

.answer-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.answer-mark {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.answer-mark.right {
  background: var(--green-50);
  color: var(--green-700);
}

.answer-mark.wrong {
  background: var(--danger-soft);
  color: var(--danger);
}

.answer-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.answer-sub {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

.answer-explain {
  margin-top: 20rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: var(--ink-2);
  background: var(--bg);
  border-radius: 14rpx;
  padding: 20rpx;
}

.answer-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--brass);
}

.answer-tip-label {
  font-weight: 600;
  margin-right: 8rpx;
}

.quiz-foot {
  margin-top: 34rpx;
}

.quiz-hint {
  text-align: center;
  font-size: 21rpx;
  color: var(--muted-2);
  padding: 20rpx 0;
}

.quiz-back {
  margin-top: 18rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
}
