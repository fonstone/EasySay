.review-history {
  padding-top: 26rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.head {
  margin-bottom: 30rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 56rpx;
  line-height: 1.3;
}

.head-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.7;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.review-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 26rpx 28rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--line);
}

.review-date {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--muted-2);
}

.review-delete {
  font-size: 19rpx;
  color: var(--muted-2);
  padding: 6rpx 0 6rpx 20rpx;
}

.review-block {
  margin-top: 18rpx;
}

.block-label {
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: var(--muted-2);
  margin-bottom: 6rpx;
}

.block-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

.stuck-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.stuck-tag {
  font-size: 18rpx;
  color: var(--danger);
  background: var(--danger-soft);
  border-radius: 6rpx;
  padding: 3rpx 10rpx;
}

.review-next {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: var(--green-50);
  border-radius: 14rpx;
}

.next-label {
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: var(--green-600);
}

.next-text {
  margin-top: 5rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--green-900);
  font-weight: 500;
}

.review-message {
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--brass);
  text-align: right;
}

.history-foot {
  margin-top: 32rpx;
}
