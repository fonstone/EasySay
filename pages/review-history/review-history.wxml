<view class="page review-history">
  <view class="head fade-up">
    <text class="eyebrow">REVIEW ARCHIVE</text>
    <view class="title serif">复盘档案</view>
    <view class="head-sub">共 {{total}} 次复盘。每一次，都是你给下一次写的说明书。</view>
  </view>

  <view wx:if="{{total}}" class="list-tools fade-up">
    <view class="list-search">
      <input
        class="list-search-input"
        value="{{keyword}}"
        placeholder="搜练了什么、卡在哪里"
        placeholder-class="list-search-placeholder"
        confirm-type="search"
        bindinput="onInput"
        aria-label="搜索复盘"
      />
      <view wx:if="{{keyword}}" class="list-clear" catchtap="clearKeyword" hover-class="tap-hover" aria-label="清空搜索词" aria-role="button">×</view>
    </view>
    <scroll-view class="list-chips" scroll-x enable-flex>
      <view class="list-chip-row">
        <view
          wx:for="{{sorts}}"
          wx:key="key"
          class="list-chip {{sort === item.key ? 'list-chip-on' : ''}}"
          data-key="{{item.key}}"
          bindtap="pickSort"
          hover-class="tap-hover"
          aria-label="按{{item.name}}排序"
          aria-role="button"
        >{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{keyword && filtered.length}}" class="list-result-note">找到 {{filtered.length}} 次复盘</view>

  <view wx:if="{{filtered.length}}" class="review-list">
    <view wx:for="{{filtered}}" wx:key="id" class="review-card fade-up">
      <view class="between">
        <view class="review-date">{{item.dateText}}</view>
        <view class="review-delete" data-id="{{item.id}}" bindtap="remove" hover-class="tap-hover" aria-role="button" aria-label="删除这次复盘">删除</view>
      </view>

      <view wx:if="{{item.learned}}" class="review-block">
        <view class="block-label">练了什么</view>
        <view class="block-text">{{item.learned}}</view>
      </view>

      <view wx:if="{{item.stuck.length || item.stuckText}}" class="review-block">
        <view class="block-label">卡在哪里</view>
        <view class="stuck-row">
          <text wx:for="{{item.stuck}}" wx:for-item="s" wx:key="*this" class="stuck-tag">{{s}}</text>
        </view>
        <view wx:if="{{item.stuckText}}" class="block-text">{{item.stuckText}}</view>
      </view>

      <view class="review-next">
        <view class="next-label">下次只改</view>
        <view class="next-text">{{item.next}}</view>
      </view>

      <view wx:if="{{item.message}}" class="review-message serif">“{{item.message}}”</view>
    </view>
  </view>

  <empty-state
    wx:if="{{!filtered.length}}"
    mark="复"
    title="{{emptyTitle}}"
    desc="{{emptyDesc}}"
    action="{{emptyAction}}"
    bind:action="onEmptyAction"
  />

  <view wx:if="{{total}}" class="history-foot">
    <view class="btn btn-soft btn-block" bindtap="goReview" hover-class="tap-hover" aria-role="button">再写一次复盘</view>
  </view>
</view>
