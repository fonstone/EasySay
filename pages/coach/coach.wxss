.coach {
  padding-top: 26rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.coach-title {
  margin-top: 12rpx;
  font-size: 60rpx;
  line-height: 1.26;
}

.head-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
  max-width: 590rpx;
}

.goal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 32rpx;
}

.goal-card {
  background: var(--card);
  border-radius: 24rpx;
  border: 1rpx solid var(--line);
  padding: 22rpx 22rpx 20rpx;
  min-height: 190rpx;
}

.goal-on {
  border-color: var(--green-600);
  box-shadow: 0 12rpx 30rpx rgba(27, 90, 71, 0.1);
}

.goal-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goal-glyph {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
}

.goal-check {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--green-600);
  color: #fff;
  font-size: var(--fs-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

.goal-name {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.goal-desc {
  margin-top: 4rpx;
  font-size: var(--fs-min);
  line-height: 1.5;
  color: var(--muted);
}

.preview-card {
  margin-top: 28rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 30rpx 28rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
}

.preview-eyebrow {
  font-size: var(--fs-min);
  letter-spacing: 3rpx;
  color: var(--green-600);
  font-weight: 600;
}

.preview-intro {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--ink-2);
}

.preview-days {
  margin-top: 22rpx;
  border-top: 1rpx dashed var(--line);
  padding-top: 12rpx;
}

.preview-day {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.preview-day:last-child {
  border-bottom: none;
}

.preview-day-num {
  width: 50rpx;
  font-size: var(--fs-min);
  color: var(--brass);
  flex-shrink: 0;
}

.preview-day-body {
  flex: 1;
  min-width: 0;
}

.preview-day-title {
  font-size: 23rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-day-cat {
  font-size: var(--fs-min);
  color: var(--muted-2);
  margin-top: 1rpx;
}

.preview-note {
  margin-top: 14rpx;
  text-align: center;
  font-size: var(--fs-min);
  color: var(--muted-2);
}

/* ---------------- 已生成计划 ---------------- */

.plan-hero {
  background: var(--gradient-green);
  border-radius: var(--radius-lg);
  padding: 34rpx 30rpx 30rpx;
  color: #fff;
  box-shadow: 0 20rpx 50rpx rgba(14, 46, 38, 0.22);
  position: relative;
  overflow: hidden;
}

.plan-hero::after {
  content: "";
  position: absolute;
  right: -100rpx;
  top: -120rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 0 0 50rpx rgba(255, 255, 255, 0.025);
}

.plan-badge {
  font-size: var(--fs-min);
  letter-spacing: 3rpx;
  color: #d8b36c;
}

.plan-day {
  font-size: var(--fs-min);
  color: rgba(255, 255, 255, 0.5);
}

.plan-title {
  margin-top: 22rpx;
  font-size: 52rpx;
  line-height: 1.25;
  color: #fff;
}

.plan-intro {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.62);
}

.today-card {
  position: relative;
  z-index: 2;
  margin-top: 26rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  color: var(--ink);
}

.today-label {
  font-size: var(--fs-min);
  letter-spacing: 2rpx;
  color: var(--brass);
  font-weight: 600;
}

.today-title {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--green-900);
  padding-right: 50rpx;
}

.today-meta {
  margin-top: 4rpx;
  font-size: var(--fs-min);
  color: var(--muted);
}

.today-cta {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  font-size: 21rpx;
  color: var(--green-700);
  font-weight: 600;
}

.today-done .today-title {
  color: var(--green-700);
}

.plan-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.plan-progress .bar {
  flex: 1;
}

.plan-progress-text {
  font-size: var(--fs-min);
  color: var(--muted-2);
  flex-shrink: 0;
}

.timeline {
  margin-top: 30rpx;
}

.timeline-item {
  display: flex;
  gap: 16rpx;
}

.timeline-left {
  width: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.timeline-dot {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--bg-deep);
  color: var(--muted-2);
  font-size: var(--fs-min);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.timeline-item.done .timeline-dot {
  background: var(--green-600);
  color: #fff;
}

.timeline-item.current .timeline-dot {
  background: var(--green-800);
  color: #fff;
  box-shadow: 0 0 0 6rpx var(--green-100);
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  background: var(--line);
  margin: 6rpx 0;
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-body {
  flex: 1;
  padding: 4rpx 0 26rpx;
  min-width: 0;
}

.timeline-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.timeline-day {
  font-size: var(--fs-min);
  letter-spacing: 2rpx;
  color: var(--muted-2);
}

.timeline-status {
  font-size: var(--fs-min);
  color: var(--muted-2);
}

.done-status {
  color: var(--green-600);
}

.current-status {
  color: var(--brass);
}

.timeline-title {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
}

.timeline-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.timeline-meta {
  margin-top: 4rpx;
  font-size: var(--fs-min);
  color: var(--muted-2);
}

.timeline-item.done .timeline-title {
  color: var(--muted);
}

.timeline-item.current .timeline-title {
  color: var(--green-800);
}

.plan-actions {
  margin-top: 30rpx;
}

.preview-focus {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-sm);
  background: var(--green-50);
  font-size: var(--fs-min);
  line-height: 1.65;
  color: var(--green-700);
}

.preview-day-reason {
  margin-top: 4rpx;
  font-size: var(--fs-min);
  color: var(--green-700);
  line-height: 1.5;
}

.plan-engine {
  margin-top: 12rpx;
  font-size: var(--fs-min);
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.72);
}

.timeline-reason {
  margin-top: 8rpx;
  font-size: var(--fs-min);
  line-height: 1.6;
  color: var(--green-700);
}
