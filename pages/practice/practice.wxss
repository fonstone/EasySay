.practice {
  padding-top: 30rpx;
}

.head {
  margin-bottom: 34rpx;
}

.practice-title {
  margin-top: 12rpx;
  font-size: 60rpx;
  line-height: 1.26;
}

.head-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
  max-width: 560rpx;
}

.random-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.random-glyph {
  font-size: 33rpx;
  color: var(--green-600);
  line-height: 1;
}

.random-text {
  font-size: 19rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.overview {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx 10rpx;
  box-shadow: var(--shadow-soft);
  margin-bottom: 22rpx;
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-num {
  font-size: 42rpx;
  line-height: 1.1;
  color: var(--ink);
  font-weight: 600;
}

.overview-total {
  font-size: 22rpx;
  color: var(--muted-2);
  font-weight: 400;
}

.overview-label {
  font-size: 19rpx;
  color: var(--muted-2);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.overview-line {
  width: 1rpx;
  height: 40rpx;
  background: var(--line);
}

.continue-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--radius);
  background: linear-gradient(120deg, #143d31, #1b5a47);
  color: #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(14, 46, 38, 0.18);
}

.continue-left {
  flex: 1;
  min-width: 0;
}

.continue-eyebrow {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.55);
}

.continue-title {
  font-size: 27rpx;
  font-weight: 600;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continue-meta {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 4rpx;
}

.continue-btn {
  flex-shrink: 0;
  font-size: 21rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.plan-strip {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 26rpx;
  background: var(--green-50);
  border: 1rpx solid var(--green-100);
  border-radius: 24rpx;
  margin-bottom: 8rpx;
}

.plan-strip-empty {
  background: var(--card);
  border-color: var(--line);
}

.plan-mark {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: var(--green-700);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}

.plan-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--green-800);
}

.plan-desc {
  font-size: 20rpx;
  color: var(--green-600);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-arrow {
  font-size: 26rpx;
  color: var(--green-600);
}

.section-head {
  margin-top: 42rpx;
  margin-bottom: 20rpx;
}

.cat-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cat-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx 28rpx 24rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid transparent;
}

.cat-card:active {
  border-color: var(--green-200);
}

.cat-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.cat-glyph {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.cat-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cat-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--ink);
}

.cat-level {
  font-size: 18rpx;
  color: var(--muted);
  background: var(--bg-deep);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.cat-tagline {
  margin-top: 5rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.cat-arrow {
  font-size: 28rpx;
  color: var(--muted-2);
  padding-top: 4rpx;
  flex-shrink: 0;
}

.cat-desc {
  margin-top: 18rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: var(--ink-2);
}

.cat-bottom {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
}

.cat-bar {
  flex: 1;
}

.cat-progress {
  font-size: 20rpx;
  color: var(--muted-2);
  flex-shrink: 0;
}

.cat-next {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line);
  min-width: 0;
}

.cat-next-label {
  font-size: 18rpx;
  color: var(--green-600);
  background: var(--green-50);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  flex-shrink: 0;
}

.cat-next-title {
  font-size: 21rpx;
  color: var(--muted);
  flex: 1;
  min-width: 0;
}

.practice-foot {
  margin-top: 44rpx;
  padding: 0 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.foot-line {
  width: 42rpx;
  height: 2rpx;
  background: var(--line-strong);
}

.foot-text {
  font-size: 21rpx;
  color: var(--muted-2);
  text-align: center;
  line-height: 1.7;
}
