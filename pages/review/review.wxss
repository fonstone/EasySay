.review {
  padding-top: 26rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.review-title {
  margin-top: 12rpx;
  font-size: 52rpx;
  line-height: 1.32;
}

.head-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
  max-width: 590rpx;
}

.history-btn {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-soft);
}

.history-num {
  font-size: 38rpx;
  line-height: 1;
  color: var(--green-700);
  font-weight: 600;
}

.history-label {
  margin-top: 6rpx;
  font-size: 17rpx;
  color: var(--muted-2);
}

.form {
  margin-top: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.field-block {
  background: var(--card);
  border-radius: var(--radius);
  padding: 26rpx 28rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--line);
}

.field-key {
  border-color: var(--green-200);
  background: #fbfdfc;
}

.field-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.field-index {
  font-size: 18rpx;
  color: var(--brass);
  letter-spacing: 1rpx;
  font-family: "Songti SC", serif;
}

.field-desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--muted);
}

.field-area {
  margin-top: 16rpx;
  width: 100%;
  min-height: 150rpx;
  background: var(--bg);
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--ink);
}

.field-area-sm {
  min-height: 100rpx;
}

.stuck-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.stuck-chip {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 21rpx;
  display: inline-flex;
  align-items: center;
  background: var(--card);
}

.stuck-on {
  background: var(--green-800);
  border-color: var(--green-800);
  color: #fff;
}

.field-input {
  margin-top: 16rpx;
  width: 100%;
  height: 88rpx;
  background: var(--bg);
  border-radius: 14rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.saved-card {
  margin-top: 40rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 50rpx 32rpx 32rpx;
  text-align: center;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--line);
}

.saved-mark {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--green-50);
  color: var(--green-700);
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.saved-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.saved-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.saved-next {
  margin-top: 28rpx;
  text-align: left;
  background: var(--green-50);
  border-radius: 18rpx;
  padding: 22rpx;
}

.saved-next-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--green-600);
}

.saved-next-text {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--green-900);
}

.saved-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.saved-actions .btn {
  flex: 1;
}

.last-review {
  margin-top: 34rpx;
  background: var(--card);
  border-radius: var(--radius);
  padding: 26rpx 28rpx;
  border: 1rpx dashed var(--line-strong);
}

.last-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--muted-2);
}

.last-date {
  font-size: 18rpx;
  color: var(--muted-2);
}

.last-next {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.last-message {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--brass);
}
