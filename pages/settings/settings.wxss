.settings {
  padding-top: 26rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.head {
  margin-bottom: 26rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 56rpx;
  line-height: 1.3;
}

.head-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.7;
}

.block {
  background: var(--card);
  border-radius: var(--radius);
  padding: 8rpx 26rpx;
  margin-top: 20rpx;
  box-shadow: var(--shadow-soft);
}

.block-title {
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--muted-2);
  font-weight: 600;
  padding: 22rpx 0 10rpx;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.field-col {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.field-col:last-child,
.field-row:last-child {
  border-bottom: none;
}

.field-key {
  font-size: 25rpx;
  color: var(--ink);
  font-weight: 500;
}

.field-hint {
  margin-top: 3rpx;
  font-size: 19rpx;
  line-height: 1.55;
  color: var(--muted-2);
}

.field-value-input {
  flex: 1;
  text-align: right;
  font-size: 25rpx;
  color: var(--muted);
  height: 52rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.pick-chip {
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--muted);
  font-size: 21rpx;
  display: inline-flex;
  align-items: center;
}

.pick-on {
  background: var(--green-800);
  color: #fff;
  border-color: var(--green-800);
}

.save-btn {
  margin-top: 24rpx;
}

.row-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row-item:last-child {
  border-bottom: none;
}

.row-item:active {
  opacity: 0.7;
}

.row-title {
  font-size: 25rpx;
  color: var(--ink);
}

.row-desc {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: var(--muted-2);
}

.row-arrow {
  font-size: 20rpx;
  color: var(--muted);
}

.row-danger {
  color: var(--danger);
}

.settings-foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 40rpx 0 10rpx;
  opacity: 0.7;
}

.foot-logo {
  width: 46rpx;
  height: 46rpx;
}

.foot-text {
  font-size: 18rpx;
  color: var(--muted-2);
  letter-spacing: 1rpx;
}
