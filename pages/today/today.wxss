.today {
  padding-top: 28rpx;
}

.header {
  margin-bottom: 34rpx;
}

.hello {
  margin-top: 12rpx;
  font-size: 46rpx;
  line-height: 1.3;
  color: var(--ink);
  letter-spacing: -0.5rpx;
}

.hello-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.55;
}

.streak-pill {
  width: 128rpx;
  height: 128rpx;
  border-radius: 30rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-soft);
}

.streak-num {
  font-size: 52rpx;
  line-height: 1;
  color: var(--green-700);
  font-weight: 600;
}

.streak-label {
  font-size: 18rpx;
  color: var(--muted-2);
  letter-spacing: 1rpx;
  margin-top: 6rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  border-radius: 40rpx;
  padding: 38rpx 36rpx 34rpx;
  background: linear-gradient(150deg, #143d31 0%, #0e2e26 62%, #143a2f 100%);
  color: #f5faf7;
  box-shadow: 0 26rpx 60rpx rgba(14, 46, 38, 0.24);
}

.hero-glow {
  position: absolute;
  right: -140rpx;
  top: -160rpx;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 0 0 64rpx rgba(255, 255, 255, 0.03), 0 0 0 150rpx rgba(255, 255, 255, 0.018);
}

.hero-top {
  position: relative;
  z-index: 2;
}

.hero-badge {
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.62);
}

.hero-level {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.hero-title {
  position: relative;
  z-index: 2;
  margin-top: 30rpx;
  font-size: 50rpx;
  line-height: 1.28;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.hero-sub {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.62);
}

.hero-meta {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 22rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.68);
}

.hero-dot {
  opacity: 0.45;
}

.hero-divider {
  position: relative;
  z-index: 2;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 28rpx 0 24rpx;
}

.hero-bottom {
  position: relative;
  z-index: 2;
  gap: 20rpx;
}

.hero-cta {
  flex: 1;
  min-width: 0;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  height: 78rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #143d31;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
}

.hero-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.hero-score {
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-score-num {
  font-size: 48rpx;
  line-height: 1;
  color: #ffffff;
  font-weight: 600;
}

.hero-score-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 5rpx;
  letter-spacing: 2rpx;
}

.hero-seal {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: 0.85;
}

.seal-inner {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
}

.quota-strip {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 26rpx;
  background: var(--brass-soft);
  border-radius: 20rpx;
  font-size: 23rpx;
  color: #7c5b2c;
}

.quota-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brass);
  flex-shrink: 0;
}

.quota-sub {
  color: #9c7c4b;
}

.quota-arrow {
  font-size: 24rpx;
  color: #9c7c4b;
}

.section {
  margin-top: 48rpx;
}

.task-progress {
  margin-bottom: 18rpx;
}

.task-list {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 28rpx;
  position: relative;
}

.task-item + .task-item::before {
  content: "";
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 0;
  height: 1rpx;
  background: var(--line);
}

.task-item:active {
  background: var(--green-50);
}

.task-check {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.task-check.checked {
  background: var(--green-600);
  border-color: var(--green-600);
}

.task-glyph {
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  background: var(--green-50);
  color: var(--green-700);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}

.task-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}

.task-desc {
  font-size: 21rpx;
  color: var(--muted-2);
  margin-top: 2rpx;
}

.task-go {
  font-size: 21rpx;
  color: var(--green-600);
  flex-shrink: 0;
}

.task-done .task-title {
  color: var(--muted);
}

.task-done .task-go {
  color: var(--muted-2);
}

.task-done .task-glyph {
  opacity: 0.55;
}

.week-card {
  margin-top: 30rpx;
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx 26rpx 24rpx;
  box-shadow: var(--shadow-soft);
}

.week-title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.week-strip {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.week-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.week-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--bg-deep);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.week-dot.filled {
  background: var(--green-600);
}

.week-dot.today {
  box-shadow: 0 0 0 4rpx var(--green-200);
}

.week-label {
  font-size: 18rpx;
  color: var(--muted-2);
}

.week-label.today-label {
  color: var(--green-700);
  font-weight: 600;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 30rpx;
}

.quick-card {
  position: relative;
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx 26rpx 30rpx;
  box-shadow: var(--shadow-soft);
  overflow: hidden;
  min-height: 218rpx;
}

.quick-card-alt {
  background: var(--green-50);
  box-shadow: none;
  border: 1rpx solid var(--green-100);
}

.quick-glyph {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--green-800);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.quick-card-alt .quick-glyph {
  background: #ffffff;
  color: var(--green-700);
}

.quick-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.quick-desc {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 6rpx;
  line-height: 1.5;
}

.quick-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  font-size: 26rpx;
  color: var(--muted-2);
}

.coach-strip {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--radius);
  background: linear-gradient(100deg, #e9f2ed, #f4f8f5);
  border: 1rpx solid var(--green-100);
}

.coach-mark {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #ffffff;
  color: var(--green-700);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.coach-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--green-800);
}

.coach-desc {
  font-size: 21rpx;
  color: var(--green-600);
  margin-top: 3rpx;
}

.coach-arrow {
  font-size: 28rpx;
  color: var(--green-600);
}

.stats-card {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--radius);
  padding: 30rpx 10rpx;
  box-shadow: var(--shadow-soft);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  line-height: 1.1;
  color: var(--ink);
  font-weight: 600;
}

.stat-label {
  font-size: 20rpx;
  color: var(--muted-2);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.stat-line {
  width: 1rpx;
  height: 44rpx;
  background: var(--line);
}

.quote-card {
  position: relative;
  margin-top: 30rpx;
  background: var(--card);
  border-radius: var(--radius);
  padding: 36rpx 32rpx 30rpx;
  border: 1rpx solid var(--line);
}

.quote-mark {
  position: absolute;
  top: 6rpx;
  left: 22rpx;
  font-size: 90rpx;
  line-height: 1;
  color: var(--green-100);
}

.quote-text {
  position: relative;
  font-size: 32rpx;
  line-height: 1.65;
  color: var(--ink-2);
}

.quote-from {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--muted-2);
  text-align: right;
  letter-spacing: 1rpx;
}

.brand-foot {
  margin-top: 44rpx;
  padding-bottom: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  opacity: 0.8;
}

.brand-lines {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  width: 40rpx;
  position: relative;
}

.brand-line {
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--green-200);
  width: 32rpx;
}

.brand-line.short {
  width: 20rpx;
}

.brand-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--brass);
}

.brand-text {
  font-size: 18rpx;
  color: var(--muted-2);
  letter-spacing: 2rpx;
}
