<view class="page has-tabbar today" wx:if="{{ready}}">
  <view class="header fade-up">
    <view class="between">
      <view class="grow">
        <text class="eyebrow">{{dateText}}</text>
        <view class="hello">{{greeting}}，<text class="serif">{{nickname}}</text></view>
        <view class="hello-sub">今天也只练一件事：把话说清楚。</view>
      </view>
      <view class="streak-pill" bindtap="goMine" hover-class="tap-hover" aria-role="button">
        <view class="streak-num serif">{{streak}}</view>
        <view class="streak-label">连续天数</view>
      </view>
    </view>
  </view>

  <view class="hero fade-up" bindtap="startToday" hover-class="tap-hover" aria-role="button">
    <view class="hero-glow"></view>
    <view class="between hero-top">
      <view class="hero-badge">TODAY · {{question.categoryName}}</view>
      <view class="hero-level">{{question.levelName}}</view>
    </view>
    <view class="hero-title serif">{{question.title}}</view>
    <view class="hero-sub">{{question.subtitle}}</view>
    <view class="hero-meta">
      <text>{{question.minSeconds}}–{{question.maxSeconds}} 秒</text>
      <text class="hero-dot">·</text>
      <text>准备 {{prepSeconds}} 秒</text>
      <text class="hero-dot">·</text>
      <text>{{done ? '今日已完成' : '本题可重录 ' + chancesLeft + ' 次'}}</text>
    </view>

    <view class="hero-divider"></view>

    <view class="between hero-bottom">
      <view class="hero-cta">
        <view class="hero-btn">{{primaryLabel}}</view>
        <view class="hero-note">{{primarySub}}</view>
      </view>
      <view wx:if="{{done && doneReport}}" class="hero-score">
        <view class="hero-score-num serif">{{doneReport.overall}}</view>
        <view class="hero-score-label">{{doneReport.grade.label}}</view>
      </view>
      <view wx:else class="hero-seal">
        <view class="seal-inner serif">开</view>
      </view>
    </view>
  </view>

  <view class="quota-strip {{quota.freeLeft === 0 ? 'quota-out' : ''}}" wx:if="{{quota && !quota.member}}" bindtap="goMember" hover-class="tap-hover" aria-role="button">
    <view class="quota-dot"></view>
    <view class="grow">
      <text wx:if="{{quota.freeLeft > 0}}">{{quota.summary}}</text>
      <text wx:else>今日完整点评已用完，明天再来或解锁会员</text>
      <text class="quota-sub"> · 会员不限次</text>
    </view>
    <view class="quota-arrow">→</view>
  </view>

  <view class="section fade-up">
    <view class="section-head">
      <view class="section-title">今日清单</view>
      <view class="section-more">{{taskDone}} / {{taskTotal}}</view>
    </view>
    <view class="task-progress">
      <view class="bar"><view class="bar-fill" style="width: {{taskDone / taskTotal * 100}}%;"></view></view>
    </view>
    <view class="task-list">
      <view
        wx:for="{{tasks}}"
        wx:key="key"
        class="task-item {{item.done ? 'task-done' : ''}}"
        data-key="{{item.key}}"
        bindtap="handleTask" hover-class="tap-hover" aria-role="button">
        <view class="task-check {{item.done ? 'checked' : ''}}">{{item.done ? '✓' : ''}}</view>
        <view class="task-glyph serif">{{item.icon}}</view>
        <view class="grow">
          <view class="task-title">{{item.title}}</view>
          <view class="task-desc">{{item.desc}}</view>
        </view>
        <view class="task-go">{{item.done ? '已完成' : '去完成'}}</view>
      </view>
    </view>
  </view>

  <view class="week-card fade-up">
    <view class="between">
      <view class="week-title">这一周</view>
      <view class="tiny">{{weekSessions}} 次开口 · {{weekMinutes}} 分钟</view>
    </view>
    <view class="week-strip">
      <view wx:for="{{week}}" wx:key="key" class="week-day">
        <view class="week-dot {{item.checkedIn ? 'filled' : ''}} {{item.isToday ? 'today' : ''}}">
          {{item.checkedIn ? '✓' : ''}}
        </view>
        <view class="week-label {{item.isToday ? 'today-label' : ''}}">{{item.isToday ? '今天' : '周' + item.label}}</view>
      </view>
    </view>
  </view>

  <view class="quick-grid fade-up">
    <view class="quick-card" bindtap="goScene" hover-class="tap-hover" aria-role="button">
      <view class="quick-glyph serif">场</view>
      <view class="quick-title">3 分钟场景对练</view>
      <view class="quick-desc">把难说的话，提前练一遍</view>
      <view class="quick-arrow">→</view>
    </view>
    <view class="quick-card quick-card-alt" bindtap="goThinking" hover-class="tap-hover" aria-role="button">
      <view class="quick-glyph serif">思</view>
      <view class="quick-title">思维小题</view>
      <view class="quick-desc">事实、观点，还是猜测？</view>
      <view class="quick-arrow">→</view>
    </view>
  </view>

  <view class="coach-strip fade-up" bindtap="goCoach" hover-class="tap-hover" aria-role="button">
    <view class="coach-mark serif">师</view>
    <view class="grow">
      <view class="coach-title">让私教替你排一周</view>
      <view class="coach-desc">选一个目标，七天只练该练的</view>
    </view>
    <view class="coach-arrow">→</view>
  </view>

  <view class="stats-card fade-up">
    <view class="stat">
      <view class="stat-num serif">{{weekSessions}}</view>
      <view class="stat-label">本周开口</view>
    </view>
    <view class="stat-line"></view>
    <view class="stat">
      <view class="stat-num serif">{{weekMinutes}}</view>
      <view class="stat-label">本周分钟</view>
    </view>
    <view class="stat-line"></view>
    <view class="stat">
      <view class="stat-num serif">{{weekAvg || '—'}}</view>
      <view class="stat-label">平均得分</view>
    </view>
  </view>

  <view class="quote-card fade-up">
    <view class="quote-mark serif">“</view>
    <view class="quote-text serif">{{quote.text}}</view>
    <view class="quote-from">—— {{quote.from}}</view>
  </view>

  <view class="brand-foot">
    <view class="brand-lines">
      <view class="brand-line"></view>
      <view class="brand-line short"></view>
      <view class="brand-dot"></view>
    </view>
    <text class="brand-text">清述 · 每天三分钟，练一次好好说话</text>
  </view>
</view>

<view wx:else class="page has-tabbar skeleton-page" aria-label="正在加载页面内容">
  <view class="sk sk-title"></view>
  <view class="sk sk-card"></view>
  <view class="sk sk-strip"></view>
  <view class="sk sk-card"></view>
  <view class="sk sk-card sk-tall"></view>
</view>
