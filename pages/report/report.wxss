.report {
  padding-top: 26rpx;
  padding-bottom: calc(50rpx + env(safe-area-inset-bottom));
}

.report-top {
  padding: 10rpx 6rpx 28rpx;
}

.report-title {
  margin-top: 12rpx;
  font-size: 52rpx;
  line-height: 1.3;
  color: var(--ink);
  letter-spacing: -0.5rpx;
}

.report-line {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

.score-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background:
    radial-gradient(circle at 6% 10%, rgba(47, 123, 99, 0.08), transparent 46%),
    var(--card);
  border-radius: var(--radius-lg);
  padding: 30rpx 28rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
}

.score-side {
  flex: 1;
  min-width: 0;
}

.score-cat {
  font-size: var(--fs-min);
  letter-spacing: 2rpx;
  color: var(--green-600);
  font-weight: 600;
}

.score-q {
  margin-top: 8rpx;
  font-size: 36rpx;
  line-height: 1.35;
  color: var(--ink);
}

.score-note {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.score-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.score-tag {
  font-size: var(--fs-min);
  color: var(--muted);
  background: var(--bg-deep);
  border-radius: var(--radius-xs);
  padding: 4rpx 10rpx;
}

.fact-strip {
  display: flex;
  margin-top: 20rpx;
  background: var(--card);
  border-radius: var(--radius);
  padding: 24rpx 6rpx;
  box-shadow: var(--shadow-soft);
}

.fact {
  flex: 1;
  text-align: center;
  position: relative;
}

.fact + .fact::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: var(--line);
}

.fact-value {
  font-size: 36rpx;
  line-height: 1.1;
  color: var(--ink);
  font-weight: 600;
}

.fact-unit {
  font-size: var(--fs-min);
  color: var(--muted-2);
  margin-left: 3rpx;
  font-weight: 400;
}

.fact-label {
  margin-top: 8rpx;
  font-size: var(--fs-min);
  color: var(--muted-2);
  letter-spacing: 1rpx;
}

.dim-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 10rpx 28rpx 20rpx;
  box-shadow: var(--shadow-soft);
}

.dim-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.dim-row:last-child {
  border-bottom: none;
}

.dim-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.dim-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
}

.dim-muted {
  font-size: var(--fs-min);
  color: var(--muted-2);
  background: var(--bg-deep);
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
  margin-left: 8rpx;
  font-weight: 400;
}

.dim-score {
  font-size: 30rpx;
  font-weight: 600;
  font-family: "Songti SC", serif;
}

.dim-score.high { color: var(--green-700); }
.dim-score.mid { color: var(--brass); }
.dim-score.low { color: var(--danger); }

.dim-detail {
  margin-top: 8rpx;
  font-size: var(--fs-min);
  color: var(--muted-2);
}

.coach-card {
  position: relative;
  overflow: hidden;
  background: var(--gradient-green);
  color: #f4faf7;
  border-radius: var(--radius-lg);
  padding: 34rpx 30rpx 30rpx;
  box-shadow: 0 20rpx 50rpx rgba(14, 46, 38, 0.2);
}

.coach-card::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: -130rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 0 0 54rpx rgba(255, 255, 255, 0.025);
  pointer-events: none;
}

.coach-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #ffffff;
}

.coach-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #d8b36c;
}

.coach-engine {
  font-size: var(--fs-min);
  color: rgba(255, 255, 255, 0.38);
  letter-spacing: 1rpx;
}

.coach-reason {
  position: relative;
  z-index: 2;
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.85;
  color: rgba(255, 255, 255, 0.86);
}

.evidence-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.evidence-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  max-width: 100%;
}

.evidence-label {
  font-size: var(--fs-min);
  color: #d8b36c;
  flex-shrink: 0;
}

.evidence-text {
  font-size: var(--fs-min);
  color: rgba(255, 255, 255, 0.62);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 420rpx;
}

.coach-group {
  position: relative;
  z-index: 2;
  margin-top: 30rpx;
}

.coach-group-label {
  font-size: var(--fs-min);
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 14rpx;
}

.coach-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 12rpx 0;
}

.coach-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.coach-icon.good {
  background: rgba(146, 203, 175, 0.16);
  color: #a8d8c2;
}

.coach-icon.bad {
  background: rgba(216, 179, 108, 0.16);
  color: #e2c389;
}

.coach-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.82);
}

.next-focus {
  position: relative;
  z-index: 2;
  margin-top: 30rpx;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  color: var(--ink);
}

.next-focus-label {
  font-size: var(--fs-min);
  letter-spacing: 3rpx;
  color: var(--brass);
  font-weight: 600;
}

.next-focus-text {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--green-900);
  font-weight: 500;
  padding-right: 40rpx;
}

.next-focus-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 28rpx;
  color: var(--green-600);
}

.locked-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 46rpx 36rpx 36rpx;
  text-align: center;
  border: 1rpx solid var(--brass-soft);
  box-shadow: var(--shadow-soft);
}

.locked-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brass-soft);
  color: var(--brass);
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 22rpx;
}

.locked-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.locked-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--muted);
}

.locked-benefits {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  text-align: left;
}

.locked-benefit {
  font-size: 21rpx;
  color: var(--green-700);
  background: var(--green-50);
  border-radius: var(--radius-xs);
  padding: 8rpx 14rpx;
}

.transcript-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  box-shadow: var(--shadow-soft);
}

.transcript-title {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.material-toggle {
  font-size: 21rpx;
  color: var(--green-600);
}

.text-stats {
  display: flex;
  margin-top: 22rpx;
  padding: 16rpx 0;
  background: var(--green-50);
  border-radius: 16rpx;
}

.text-stat {
  flex: 1;
  text-align: center;
}

.text-stat-num {
  font-size: 30rpx;
  color: var(--green-800);
  font-weight: 600;
}

.text-stat-label {
  display: block;
  font-size: var(--fs-min);
  color: var(--green-600);
  margin-top: 2rpx;
}

.transcript-body {
  margin-top: 20rpx;
  font-size: 25rpx;
  line-height: 1.85;
  color: var(--ink-2);
  background: var(--bg);
  border-radius: 16rpx;
  padding: 22rpx;
  white-space: pre-wrap;
}

.transcript-input-wrap {
  margin-top: 20rpx;
}

.field-textarea {
  min-height: 200rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 25rpx;
}

.transcript-hint {
  margin-top: 12rpx;
  font-size: var(--fs-min);
  color: var(--muted-2);
  line-height: 1.6;
}

.btn-loading {
  opacity: 0.6;
}

.delivery-note {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  background: var(--green-50);
  color: var(--green-700);
  font-size: 20rpx;
  border-radius: 14rpx;
  line-height: 1.6;
  text-align: center;
}

.audio-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 26rpx 28rpx;
  box-shadow: var(--shadow-soft);
}

.audio-time {
  font-size: 20rpx;
  color: var(--muted-2);
  letter-spacing: 1rpx;
}

.audio-main {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 20rpx;
}

.play-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--green-800);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 24rpx rgba(14, 46, 38, 0.18);
}

.play-btn:active {
  transform: scale(0.95);
}

.play-tri {
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 22rpx solid #ffffff;
  margin-left: 6rpx;
}

.pause-icon {
  display: flex;
  gap: 8rpx;
}

.pause-icon view {
  width: 7rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: #ffffff;
}

.audio-wave {
  flex: 1;
  height: 86rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  overflow: hidden;
}

.audio-bar {
  flex: 1;
  min-width: 3rpx;
  border-radius: var(--radius-pill);
  background: var(--green-100);
  transition: background 0.2s;
}

.audio-bar.on {
  background: var(--green-600);
}

.audio-error {
  margin-top: 16rpx;
  font-size: var(--fs-min);
  color: var(--danger);
}

.audio-note {
  margin-top: 16rpx;
  font-size: var(--fs-min);
  color: var(--muted-2);
  text-align: center;
}

.quote-card {
  background: var(--gradient-paper);
  border: 1rpx solid var(--brass-soft);
  border-radius: var(--radius);
  padding: 28rpx 30rpx;
}

.quote-actions {
  display: flex;
  gap: 16rpx;
}

.quote-action {
  font-size: 20rpx;
  color: var(--brass);
}

.quote-action-done {
  color: var(--muted-2);
}

.quote-text {
  margin-top: 20rpx;
  font-size: 34rpx;
  line-height: 1.65;
  color: #5c4727;
}

.quote-note {
  margin-top: 14rpx;
  font-size: var(--fs-min);
  color: #9c855f;
  text-align: right;
}

.report-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 40rpx;
}

.report-actions .btn {
  flex: 1;
}

.share-btn {
  margin-top: 22rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  padding: 16rpx 0;
}

.fav-strip {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
}

.fav-mark {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  background: var(--brass-soft);
  color: var(--brass);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.fav-desc {
  font-size: var(--fs-min);
  color: var(--muted);
  margin-top: 2rpx;
}

.fav-arrow {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--muted-2);
}

.report-foot {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.foot-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--line-strong);
}

.foot-text {
  font-size: var(--fs-min);
  line-height: 1.7;
  color: var(--muted-2);
  text-align: center;
  padding: 0 20rpx;
}

/* ---------- 分数与维度解释 ---------- */

.score-help {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--green-50);
  color: var(--green-700);
  font-size: var(--fs-min);
  font-weight: 600;
}

.score-guide {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
}

.score-guide-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.score-guide-line {
  font-size: var(--fs-min);
  color: var(--muted);
  line-height: 1.8;
  padding-left: 20rpx;
  position: relative;
}

.score-guide-line::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--green-500);
}

.dim-head {
  align-items: center;
}

.dim-name {
  flex: 1;
  min-width: 0;
}

.dim-from {
  font-size: var(--fs-min);
  font-weight: 400;
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill);
  white-space: nowrap;
}

.dim-from.voice {
  color: var(--green-700);
  background: var(--green-50);
}

.dim-from.text {
  color: var(--brass);
  background: var(--brass-soft);
}

.dim-score {
  margin-left: 10rpx;
}

.dim-chev {
  width: 32rpx;
  text-align: center;
  color: var(--muted-2);
  font-size: 26rpx;
  line-height: 1;
  transition: transform 0.2s ease;
}

.dim-chev.up {
  transform: rotate(180deg);
}

.dim-explain {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  background: var(--green-50);
  border-radius: var(--radius-sm);
}

.dim-explain-row {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  line-height: 1.7;
}

.dim-explain-row + .dim-explain-row {
  margin-top: 8rpx;
}

.dim-explain-label {
  flex-shrink: 0;
  font-size: var(--fs-min);
  color: var(--green-700);
  font-weight: 600;
}

.dim-explain-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-min);
  color: var(--ink-2);
}

/* ---------------- 数据来源与可解释规则 ---------------- */

.source-card {
  margin: 24rpx 0 0;
  padding: 24rpx 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}

.source-engine {
  font-size: var(--fs-min);
  color: var(--green-700);
  background: var(--green-50);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
}

.source-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.source-row:last-of-type {
  border-bottom: none;
}

.source-key {
  flex-shrink: 0;
  width: 130rpx;
  font-size: var(--fs-min);
  color: var(--muted);
}

.source-value {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-min);
  line-height: 1.6;
  color: var(--ink-2);
}

.source-warn,
.source-ok,
.source-hint {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-sm);
  font-size: var(--fs-min);
  line-height: 1.65;
}

.source-warn {
  background: #fbf1e7;
  color: #8a5a35;
}

.source-ok {
  background: var(--green-50);
  color: var(--green-700);
}

.source-hint {
  background: var(--bg-deep);
  color: var(--muted);
}

.next-focus-rule {
  margin-top: 12rpx;
  font-size: var(--fs-min);
  color: rgba(255, 255, 255, 0.58);
  line-height: 1.6;
}

.rules-toggle {
  margin-top: 22rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: var(--fs-min);
  color: #d8b36c;
  text-align: center;
}

.rules-list {
  margin-top: 8rpx;
}

.rule-item {
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg-deep);
  opacity: 0.72;
}

.rule-item + .rule-item {
  margin-top: 10rpx;
}

.rule-item.shown {
  opacity: 1;
  background: var(--card);
}

.rule-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rule-kind {
  font-size: var(--fs-min);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
}

.rule-kind.strength {
  background: var(--green-50);
  color: var(--green-700);
}

.rule-kind.weakness {
  background: #fbf1e7;
  color: #8a5a35;
}

.rule-id {
  font-size: var(--fs-min);
  color: var(--muted);
}

.rule-text {
  margin-top: 8rpx;
  font-size: var(--fs-min);
  line-height: 1.6;
  color: var(--ink-2);
}

.rule-meta {
  margin-top: 6rpx;
  font-size: var(--fs-min);
  line-height: 1.6;
  color: var(--muted);
}

.transcript-source {
  margin-top: 14rpx;
  font-size: var(--fs-min);
  color: var(--green-700);
}

.prepared-line {
  margin-top: 10rpx;
  font-size: var(--fs-min);
  line-height: 1.6;
  color: var(--muted);
}
