.onboard {
  min-height: 100vh;
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.nav {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 156rpx;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink-2);
}

.nav-ghost {
  opacity: 0;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.nav-logo {
  width: 42rpx;
  height: 42rpx;
}

.nav-name {
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--green-800);
}

.nav-skip {
  width: 72rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--muted-2);
}

.step {
  flex: 1;
  padding-top: 32rpx;
}

.step-welcome {
  display: flex;
  flex-direction: column;
  padding-top: 58rpx;
}

.welcome-eyebrow {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: var(--green-600);
  font-weight: 600;
  margin-bottom: 26rpx;
}

.welcome-title {
  font-size: 82rpx;
  line-height: 1.22;
  color: var(--ink);
  letter-spacing: -2rpx;
}

.welcome-desc {
  margin-top: 28rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--muted);
  max-width: 580rpx;
}

.welcome-points {
  margin-top: 58rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.point {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.point-num {
  width: 64rpx;
  padding-top: 2rpx;
  font-size: 25rpx;
  color: var(--brass);
  letter-spacing: 1rpx;
}

.point-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.point-desc {
  font-size: 23rpx;
  color: var(--muted);
  margin-top: 4rpx;
  line-height: 1.6;
}

.welcome-cta {
  margin-top: auto;
  padding-top: 70rpx;
}

.welcome-hint {
  margin-top: 18rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--muted-2);
}

.step-eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--muted-2);
  font-weight: 600;
  margin-bottom: 20rpx;
}

.step-title {
  font-size: 62rpx;
  line-height: 1.28;
  color: var(--ink);
  letter-spacing: -1rpx;
}

.step-desc {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.goal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 42rpx;
}

.goal-card {
  position: relative;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  padding: 26rpx 24rpx;
  min-height: 200rpx;
  transition: border-color 0.18s, box-shadow 0.18s;
}

.goal-active {
  border-color: var(--green-600);
  box-shadow: 0 12rpx 30rpx rgba(27, 90, 71, 0.12);
}

.goal-glyph {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.goal-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.goal-desc {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.55;
  color: var(--muted);
}

.goal-check {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--green-600);
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.level-list {
  margin-top: 42rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.level-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  transition: border-color 0.18s;
}

.level-active {
  border-color: var(--green-600);
  background: #fbfdfc;
}

.level-glyph {
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  background: var(--green-50);
  color: var(--green-700);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.level-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.level-desc {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
  line-height: 1.55;
}

.level-radio {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line-strong);
  flex-shrink: 0;
}

.level-radio.on {
  border: 10rpx solid var(--green-600);
}

.time-row {
  display: flex;
  gap: 16rpx;
  margin-top: 42rpx;
}

.time-card {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  padding: 28rpx 10rpx 24rpx;
  text-align: center;
  transition: border-color 0.18s;
}

.time-active {
  border-color: var(--green-600);
  background: #fbfdfc;
  box-shadow: 0 12rpx 30rpx rgba(27, 90, 71, 0.1);
}

.time-num {
  font-size: 52rpx;
  line-height: 1;
  color: var(--ink);
  font-weight: 600;
}

.time-unit {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.time-desc {
  font-size: 19rpx;
  color: var(--muted-2);
  margin-top: 12rpx;
}

.nickname-box {
  margin-top: 46rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}

.nickname-input {
  height: 56rpx;
  font-size: 30rpx;
  color: var(--ink);
  margin-top: 6rpx;
}

.privacy-note {
  margin-top: 26rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--muted-2);
  padding: 0 8rpx;
}

.onboard-foot {
  padding-top: 50rpx;
}

.dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.dot-item {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--line-strong);
  transition: width 0.2s, background 0.2s;
}

.dot-item.on {
  width: 34rpx;
  border-radius: 999rpx;
  background: var(--green-600);
}

.foot-hint {
  text-align: center;
  font-size: 20rpx;
  color: var(--muted-2);
  padding-top: 100rpx;
}
